# LiveWord 설정 양식
#
# 이 파일을 복사해 `.env` 로 이름을 바꾸고 실제 값을 채우세요.
# 보통은 직접 편집할 필요 없이, 프로그램을 처음 실행하면 나오는
# 설정(setup) 화면에서 입력하면 자동으로 만들어집니다.
#
# 저장 위치 (APP_DIR): .exe 가 있는 폴더를 먼저 사용하고,
#   쓰기가 막혀 있으면 %APPDATA%\LiveWord 로 넘어갑니다.
#     C:\Users\<사용자>\AppData\Local\Programs\LiveWord\.env
#     C:\Users\<사용자>\AppData\Roaming\LiveWord\.env
#
# ⚠️ 이 파일에 실제 키를 채운 뒤에는 git 에 올리지 마세요.
#    .gitignore 에 .env 와 *.json 이 이미 등록되어 있습니다.


# ── 번역 (Anthropic Claude) ────────────────────────────────
# 발급: https://console.anthropic.com/settings/keys
# 없으면: 번역이 전혀 되지 않습니다.
# 참고: "번역이 갑자기 멈췄다"는 증상은 대개 코드 문제가 아니라
#       크레딧 잔액 소진입니다. 잔액을 먼저 확인하세요.
ANTHROPIC_API_KEY=sk-ant-...


# ── 음성 인식 + 번역 음성 (Google Cloud) ───────────────────
# 서비스 계정 JSON 파일의 "경로"를 적습니다. 키 값 자체가 아닙니다.
# 준비: Google Cloud 콘솔에서 아래 두 API 를 모두 사용 설정한 뒤
#         - Cloud Speech-to-Text API   (설교 음성 인식)
#         - Cloud Text-to-Speech API   (번역 음성 합성)
#       서비스 계정을 만들고 JSON 키를 내려받습니다.
# 없으면: 자막이 시작되지 않거나(STT), 자막만 나오고 소리가 없습니다(TTS).
GOOGLE_APPLICATION_CREDENTIALS=C:\경로\google-key.json


# ── 외부 접속 터널 (ngrok) ─────────────────────────────────
# 교인 휴대폰이 교회 밖 네트워크에서도 접속할 수 있게 해 줍니다.
# 발급: https://dashboard.ngrok.com/get-started/your-authtoken
# 없으면: QR 접속이 안 되고, 같은 와이파이에서만 사용할 수 있습니다.
NGROK_AUTHTOKEN=

# 고정 도메인. 무료 플랜도 하나 만들 수 있습니다.
# 고정 도메인을 쓰면 QR 코드와 안내 포스터를 다시 만들지 않아도 됩니다.
# 발급: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=이름-이름-이름.ngrok-free.dev
